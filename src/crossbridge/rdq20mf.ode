# RDQ20-MF (Regazzoni, Dede', Quarteroni 2020), as crossbridge.RDQ20MF implements it.
# GENERATED by tools/generate_rdq20mf_ode.py: change the generator, not this file.
# Loaded through RDQ20MF.ODE_FILE; tests/test_ode_files.py pins it to the class.
#
# Units: s, uM, um; Ta and Ka are reported in kPa (Ka per unit Lambda).
#
# The contract: the component `inputs` holds Ca, SL and dSL. Standalone they are
# parameters; subtracting the component turns them into missing variables. The outputs
# are the intermediates Ta, Ka and bound_ca.
# States: x_abcB = x_RU[a, b, c, B]; mu0_P, mu1_P, mu0_N, mu1_N =
# x_XB[0, 0], x_XB[1, 0], x_XB[0, 1], x_XB[1, 1].

parameters("inputs", Ca = 0.1, SL = 2.2, dSL = 0.0)

parameters("rdq20mf",
LA = 1.25, LM = 1.65, LB = 0.18, SL0 = 2.2, mu = 10.0, gamma = 12.0, Q = 2.0,
Kd0 = 0.381, alphaKd = -0.571, Koff = 100.0, Kbasic = 13.0,
r0 = 134.31, alpha = 25.184, mu0_fP = 32.653, mu1_fP = 0.778, a_XB = 22894.0
)

states("RU", x_0000 = 1.0, x_0001 = 0.0, x_0010 = 0.0, x_0011 = 0.0, x_0100 = 0.0, x_0101 = 0.0, x_0110 = 0.0, x_0111 = 0.0, x_1000 = 0.0, x_1001 = 0.0, x_1010 = 0.0, x_1011 = 0.0, x_1100 = 0.0, x_1101 = 0.0, x_1110 = 0.0, x_1111 = 0.0)
states("XB", mu0_P = 0.0, mu1_P = 0.0, mu0_N = 0.0, mu1_N = 0.0)

expressions("RU")
Kd = Kd0 - alphaKd * (2.15 - SL)
Kon_Ca = Koff / Kd * Ca
PhiT_C_0000 = x_0000 * Q * Kbasic * gamma**0 / mu
PhiT_C_0001 = x_0001 * Q * Kbasic * gamma**0
PhiT_C_0010 = x_0010 * Q * Kbasic * gamma**1 / mu
PhiT_C_0011 = x_0011 * Q * Kbasic * gamma**1
PhiT_C_0100 = x_0100 * Kbasic * gamma**2
PhiT_C_0101 = x_0101 * Kbasic * gamma**2
PhiT_C_0110 = x_0110 * Kbasic * gamma**1
PhiT_C_0111 = x_0111 * Kbasic * gamma**1
PhiT_C_1000 = x_1000 * Q * Kbasic * gamma**1 / mu
PhiT_C_1001 = x_1001 * Q * Kbasic * gamma**1
PhiT_C_1010 = x_1010 * Q * Kbasic * gamma**2 / mu
PhiT_C_1011 = x_1011 * Q * Kbasic * gamma**2
PhiT_C_1100 = x_1100 * Kbasic * gamma**1
PhiT_C_1101 = x_1101 * Kbasic * gamma**1
PhiT_C_1110 = x_1110 * Kbasic * gamma**0
PhiT_C_1111 = x_1111 * Kbasic * gamma**0
kT_L_00 = Conditional(Gt(x_0000 + x_0001 + x_1000 + x_1001, 0.0), (PhiT_C_0000 + PhiT_C_0001 + PhiT_C_1000 + PhiT_C_1001) / (x_0000 + x_0001 + x_1000 + x_1001), 0.0)
kT_L_01 = Conditional(Gt(x_0010 + x_0011 + x_1010 + x_1011, 0.0), (PhiT_C_0010 + PhiT_C_0011 + PhiT_C_1010 + PhiT_C_1011) / (x_0010 + x_0011 + x_1010 + x_1011), 0.0)
kT_L_10 = Conditional(Gt(x_0100 + x_0101 + x_1100 + x_1101, 0.0), (PhiT_C_0100 + PhiT_C_0101 + PhiT_C_1100 + PhiT_C_1101) / (x_0100 + x_0101 + x_1100 + x_1101), 0.0)
kT_L_11 = Conditional(Gt(x_0110 + x_0111 + x_1110 + x_1111, 0.0), (PhiT_C_0110 + PhiT_C_0111 + PhiT_C_1110 + PhiT_C_1111) / (x_0110 + x_0111 + x_1110 + x_1111), 0.0)
kT_R_00 = Conditional(Gt(x_0000 + x_0001 + x_0010 + x_0011, 0.0), (PhiT_C_0000 + PhiT_C_0001 + PhiT_C_0010 + PhiT_C_0011) / (x_0000 + x_0001 + x_0010 + x_0011), 0.0)
kT_R_01 = Conditional(Gt(x_0100 + x_0101 + x_0110 + x_0111, 0.0), (PhiT_C_0100 + PhiT_C_0101 + PhiT_C_0110 + PhiT_C_0111) / (x_0100 + x_0101 + x_0110 + x_0111), 0.0)
kT_R_10 = Conditional(Gt(x_1000 + x_1001 + x_1010 + x_1011, 0.0), (PhiT_C_1000 + PhiT_C_1001 + PhiT_C_1010 + PhiT_C_1011) / (x_1000 + x_1001 + x_1010 + x_1011), 0.0)
kT_R_11 = Conditional(Gt(x_1100 + x_1101 + x_1110 + x_1111, 0.0), (PhiT_C_1100 + PhiT_C_1101 + PhiT_C_1110 + PhiT_C_1111) / (x_1100 + x_1101 + x_1110 + x_1111), 0.0)
dx_0000_dt = (kT_L_10 * x_1000 + PhiT_C_0100 + kT_R_01 * x_0010 + Koff * x_0001) - (kT_L_00 * x_0000 + PhiT_C_0000 + kT_R_00 * x_0000 + Kon_Ca * x_0000)
dx_0001_dt = (kT_L_10 * x_1001 + PhiT_C_0101 + kT_R_01 * x_0011 + Kon_Ca * x_0000) - (kT_L_00 * x_0001 + PhiT_C_0001 + kT_R_00 * x_0001 + Koff * x_0001)
dx_0010_dt = (kT_L_10 * x_1010 + PhiT_C_0110 + kT_R_00 * x_0000 + Koff * x_0011) - (kT_L_00 * x_0010 + PhiT_C_0010 + kT_R_01 * x_0010 + Kon_Ca * x_0010)
dx_0011_dt = (kT_L_10 * x_1011 + PhiT_C_0111 + kT_R_00 * x_0001 + Kon_Ca * x_0010) - (kT_L_00 * x_0011 + PhiT_C_0011 + kT_R_01 * x_0011 + Koff * x_0011)
dx_0100_dt = (kT_L_11 * x_1100 + PhiT_C_0000 + kT_R_11 * x_0110 + Koff / mu * x_0101) - (kT_L_01 * x_0100 + PhiT_C_0100 + kT_R_10 * x_0100 + Kon_Ca * x_0100)
dx_0101_dt = (kT_L_11 * x_1101 + PhiT_C_0001 + kT_R_11 * x_0111 + Kon_Ca * x_0100) - (kT_L_01 * x_0101 + PhiT_C_0101 + kT_R_10 * x_0101 + Koff / mu * x_0101)
dx_0110_dt = (kT_L_11 * x_1110 + PhiT_C_0010 + kT_R_10 * x_0100 + Koff / mu * x_0111) - (kT_L_01 * x_0110 + PhiT_C_0110 + kT_R_11 * x_0110 + Kon_Ca * x_0110)
dx_0111_dt = (kT_L_11 * x_1111 + PhiT_C_0011 + kT_R_10 * x_0101 + Kon_Ca * x_0110) - (kT_L_01 * x_0111 + PhiT_C_0111 + kT_R_11 * x_0111 + Koff / mu * x_0111)
dx_1000_dt = (kT_L_00 * x_0000 + PhiT_C_1100 + kT_R_01 * x_1010 + Koff * x_1001) - (kT_L_10 * x_1000 + PhiT_C_1000 + kT_R_00 * x_1000 + Kon_Ca * x_1000)
dx_1001_dt = (kT_L_00 * x_0001 + PhiT_C_1101 + kT_R_01 * x_1011 + Kon_Ca * x_1000) - (kT_L_10 * x_1001 + PhiT_C_1001 + kT_R_00 * x_1001 + Koff * x_1001)
dx_1010_dt = (kT_L_00 * x_0010 + PhiT_C_1110 + kT_R_00 * x_1000 + Koff * x_1011) - (kT_L_10 * x_1010 + PhiT_C_1010 + kT_R_01 * x_1010 + Kon_Ca * x_1010)
dx_1011_dt = (kT_L_00 * x_0011 + PhiT_C_1111 + kT_R_00 * x_1001 + Kon_Ca * x_1010) - (kT_L_10 * x_1011 + PhiT_C_1011 + kT_R_01 * x_1011 + Koff * x_1011)
dx_1100_dt = (kT_L_01 * x_0100 + PhiT_C_1000 + kT_R_11 * x_1110 + Koff / mu * x_1101) - (kT_L_11 * x_1100 + PhiT_C_1100 + kT_R_10 * x_1100 + Kon_Ca * x_1100)
dx_1101_dt = (kT_L_01 * x_0101 + PhiT_C_1001 + kT_R_11 * x_1111 + Kon_Ca * x_1100) - (kT_L_11 * x_1101 + PhiT_C_1101 + kT_R_10 * x_1101 + Koff / mu * x_1101)
dx_1110_dt = (kT_L_01 * x_0110 + PhiT_C_1010 + kT_R_10 * x_1100 + Koff / mu * x_1111) - (kT_L_11 * x_1110 + PhiT_C_1110 + kT_R_11 * x_1110 + Kon_Ca * x_1110)
dx_1111_dt = (kT_L_01 * x_0111 + PhiT_C_1011 + kT_R_10 * x_1101 + Kon_Ca * x_1110) - (kT_L_11 * x_1111 + PhiT_C_1111 + kT_R_11 * x_1111 + Koff / mu * x_1111)
perm = x_0100 + x_0101 + x_0110 + x_0111 + x_1100 + x_1101 + x_1110 + x_1111
bound_ca = x_0001 + x_0011 + x_0101 + x_0111 + x_1001 + x_1011 + x_1101 + x_1111

expressions("XB")
k_PN = Conditional(Gt(x_0100 + x_0101 + x_0110 + x_0111 + x_1100 + x_1101 + x_1110 + x_1111, 0.0), (x_0100 * Kbasic * gamma**2 + x_0101 * Kbasic * gamma**2 + x_0110 * Kbasic * gamma**1 + x_0111 * Kbasic * gamma**1 + x_1100 * Kbasic * gamma**1 + x_1101 * Kbasic * gamma**1 + x_1110 * Kbasic * gamma**0 + x_1111 * Kbasic * gamma**0) / (x_0100 + x_0101 + x_0110 + x_0111 + x_1100 + x_1101 + x_1110 + x_1111), 0.0)
k_NP = Conditional(Gt(x_0000 + x_0001 + x_0010 + x_0011 + x_1000 + x_1001 + x_1010 + x_1011, 0.0), (x_0000 * Q * Kbasic * gamma**0 / mu + x_0001 * Q * Kbasic * gamma**0 + x_0010 * Q * Kbasic * gamma**1 / mu + x_0011 * Q * Kbasic * gamma**1 + x_1000 * Q * Kbasic * gamma**1 / mu + x_1001 * Q * Kbasic * gamma**1 + x_1010 * Q * Kbasic * gamma**2 / mu + x_1011 * Q * Kbasic * gamma**2) / (x_0000 + x_0001 + x_0010 + x_0011 + x_1000 + x_1001 + x_1010 + x_1011), 0.0)
v = -dSL / SL0
r = r0 + alpha * Abs(v)
dmu0_P_dt = -(r + k_PN) * mu0_P + k_NP * mu0_N + perm * mu0_fP
dmu1_P_dt = -v * mu0_P - (r + k_PN) * mu1_P + k_NP * mu1_N + perm * mu1_fP
dmu0_N_dt = k_PN * mu0_P - (r + k_NP) * mu0_N
dmu1_N_dt = k_PN * mu1_P - v * mu0_N - (r + k_NP) * mu1_N

expressions("tension")
LMh = (LM - LB) * 0.5
frac_SO = Conditional(And(Gt(SL, LA), Le(SL, LM)), SL - LA, Conditional(And(Gt(SL, LM), Le(SL, 2*LA - LB)), (SL + LM - 2*LA) * 0.5, Conditional(And(Gt(SL, 2*LA - LB), Le(SL, 2*LA + LB)), LMh, Conditional(And(Gt(SL, 2*LA + LB), Le(SL, 2*LA + LM)), (LM + 2*LA - SL) * 0.5, 0.0)))) / LMh
Ta = a_XB * (mu1_P + mu1_N) * frac_SO
Ka = a_XB * (mu0_P + mu0_N) * frac_SO
